<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CodeAnalysisRuleSet>..\OrchardBasicCorrectness.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Orchard.FluentPath" Version="1.0.0.1" />
    <!-- SpecFlow is end-of-life: Reqnroll is its maintained successor. The feature code-behind files are generated at build time. -->
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- The site templates are copied to the output folder, they are deployed into a temporary site by WebHost. -->
    <None Update="Hosting\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orchard.Web\Core\Orchard.Core.csproj" />
    <ProjectReference Include="..\Orchard.Web\Modules\Orchard.Roles\Orchard.Roles.csproj" />
    <ProjectReference Include="..\Orchard.Web\Modules\Orchard.Setup\Orchard.Setup.csproj" />
    <ProjectReference Include="..\Orchard.Web\Orchard.Web.csproj" />
    <ProjectReference Include="..\Orchard\Orchard.Framework.csproj" />
    <ProjectReference Include="..\Tools\Orchard\Orchard.csproj" />
  </ItemGroup>
</Project>
