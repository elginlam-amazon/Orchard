<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <!-- Exclude module/core/theme source files - they're compiled by their own projects -->
  <ItemGroup>
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="Modules\**\*.cs" />
    <Compile Remove="Themes\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Glimpse" Version="1.8.6" />
    <PackageReference Include="Glimpse.AspNet" Version="1.9.2" />
    <PackageReference Include="Glimpse.Mvc5" Version="1.5.3" />
    <PackageReference Include="MySql.Data" Version="6.10.9" />
    <PackageReference Include="Npgsql" Version="4.0.17" />
    <PackageReference Include="Orchard.NuGet.Core" Version="1.1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orchard.WarmupStarter\Orchard.WarmupStarter.csproj" />
    <ProjectReference Include="..\Orchard\Orchard.Framework.csproj" />
    <ProjectReference Include="..\Tools\Orchard\Orchard.csproj" />
    <ProjectReference Include="Core\Orchard.Core.csproj" />
    <ProjectReference Include="Modules\Orchard.Glimpse\Orchard.Glimpse.csproj" />
  </ItemGroup>
</Project>
