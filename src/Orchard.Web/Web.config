<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration of the ASP.NET Core host (the application settings are in App.config, the pipeline in Program.cs).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\bin\Orchard.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\App_Data\Logs\stdout" hostingModel="inprocess" />
      <!-- Prevent IIS 7.0 from returning a custom 404/500 error page of its own. -->
      <httpErrors existingResponse="PassThrough"/>
      <security>
        <requestFiltering>
          <!-- Accept file uploads up to 64 MB. -->
          <requestLimits maxAllowedContentLength="67108864"/>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
