<?xml version="1.0" encoding="utf-8"?>
<!--
  The application configuration (formerly the appSettings and connectionStrings of Web.config), copied to
  Orchard.Web.dll.config by the build and read with System.Configuration.ConfigurationManager.
-->
<configuration>
  <appSettings>
    <add key="log4net.Config" value="Config\log4net.config"/>
    <!-- Optional additional comma-separated list of folders for Modules or Themes -->
    <!--
            <add key="Modules" value="~/Ibn_Modules,~/Customer1/Modules" />
            <add key="Themes" value="~/Themes/MoreThemes,~/Customer1/Themes" />
        -->
  </appSettings>
  <connectionStrings>
    <!-- This is added to be able to use the Azure Storage Emulator by default;
         easier than a custom IPlatformConfigurationAccessor implementation. -->
    <add name="Orchard.Azure.Media.StorageConnectionString" connectionString="UseDevelopmentStorage=true"/>
  </connectionStrings>
  <!-- Optional SMTP settings used by Orchard.Email:
  <system.net>
    <mailSettings>
      <smtp from="noreply@example.com" deliveryMethod="Network">
        <network host="localhost" port="25" />
      </smtp>
    </mailSettings>
  </system.net>
  -->
</configuration>
