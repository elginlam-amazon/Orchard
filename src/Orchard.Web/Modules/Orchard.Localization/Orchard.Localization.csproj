<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- .NET Framework only package (no .NET successor), used privately by the transliteration service -->
    <PackageReference Include="Orchard.MSTranslitTools" Version="6.0.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Orchard\Orchard.Framework.csproj" />
    <ProjectReference Include="..\..\Core\Orchard.Core.csproj" />
    <ProjectReference Include="..\Orchard.Alias\Orchard.Alias.csproj" />
    <ProjectReference Include="..\Orchard.Autoroute\Orchard.Autoroute.csproj" />
    <ProjectReference Include="..\Orchard.Tokens\Orchard.Tokens.csproj" />
  </ItemGroup>
</Project>
